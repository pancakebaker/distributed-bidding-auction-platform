{
  "name": "@distributed-bidding-auction-platform/live-feed-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-admin-client.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "watch:auction": "tsx scripts/dev-socket-client.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier src/**/*.ts tests/**/*.ts scripts/**/*.ts --write",
    "format:check": "prettier src/**/*.ts tests/**/*.ts scripts/**/*.ts --check"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^0.10.5",
    "express": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
