POSTGRES_DB=auction_demo
POSTGRES_USER=auction_app
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=55432

RABBITMQ_DEFAULT_USER=auction
RABBITMQ_DEFAULT_PASS=change_me_in_local_env
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379

BIDDING_API_URL=http://localhost:5000
LIVE_FEED_URL=http://localhost:3001
LIVE_FEED_ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
LIVE_FEED_ADMIN_TOKEN_PRIVATE_KEY_PATH=.local/auth-keys/live-feed-admin-private.pem
LIVE_FEED_ADMIN_TOKEN_PUBLIC_KEY_PATH=.local/auth-keys/live-feed-admin-public.pem
LIVE_FEED_ADMIN_TOKEN_ISSUER=auction-client
LIVE_FEED_ADMIN_TOKEN_AUDIENCE=live-feed-admin


OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=1
OUTBOX_PUBLISHER_BATCH_SIZE=20
OUTBOX_PUBLISHER_MAX_PUBLISH_ATTEMPTS=1000
OUTBOX_PUBLISHER_RABBITMQ_HOST=localhost
OUTBOX_PUBLISHER_RABBITMQ_PORT=5672
OUTBOX_PUBLISHER_RABBITMQ_USERNAME=auction
OUTBOX_PUBLISHER_RABBITMQ_PASSWORD=change_me_in_local_env
OUTBOX_PUBLISHER_RABBITMQ_VHOST=/
OUTBOX_PUBLISHER_RABBITMQ_EXCHANGE=auction.events
OUTBOX_PUBLISHER_RABBITMQ_DEBUG_QUEUE=auction.events.debug
OUTBOX_PUBLISHER_RABBITMQ_DECLARE_DEBUG_QUEUE=true
LIVE_FEED_RABBITMQ_QUEUE=live-feed.bid-events
RABBITMQ_EXCHANGE=auction.events
# Legacy single-key override; LIVE_FEED_RABBITMQ_ROUTING_KEYS takes precedence.
LIVE_FEED_RABBITMQ_ROUTING_KEY=auction.bid.accepted
LIVE_FEED_RABBITMQ_ROUTING_KEYS=auction.bid.accepted,auction.closed,auction.winner.selected
LIVE_FEED_RABBITMQ_PREFETCH=10
LIVE_FEED_RABBITMQ_DLX=live-feed.dead-letter
LIVE_FEED_RABBITMQ_DLQ=live-feed.bid-events.dlq
AUCTION_OPERATIONS_RABBITMQ_HOST=localhost
AUCTION_OPERATIONS_RABBITMQ_PORT=5672
AUCTION_OPERATIONS_RABBITMQ_USERNAME=auction
AUCTION_OPERATIONS_RABBITMQ_PASSWORD=change_me_in_local_env
AUCTION_OPERATIONS_RABBITMQ_VHOST=/
AUCTION_OPERATIONS_RABBITMQ_EXCHANGE=auction.events
AUCTION_OPERATIONS_DATABASE_URL=Host=127.0.0.1;Port=55432;Database=auction_operations;Username=auction_app;Password=change_me_in_local_env
AUCTION_OPERATIONS_RABBITMQ_QUEUE=auction-operations.activity
AUCTION_OPERATIONS_RABBITMQ_DLQ=auction-operations.activity.dlq
AUCTION_OPERATIONS_RABBITMQ_DLX=auction-operations.dead-letter
AUCTION_OPERATIONS_RABBITMQ_PREFETCH=10
AUCTION_OPERATIONS_RABBITMQ_MAX_REQUEUE_ATTEMPTS=3
LaravelAuth__Issuer=auction-client
LaravelAuth__Audience=auction-operations-portal
LaravelAuth__Permission=access-auction-operations
LaravelAuth__PublicKeyPath=.local/auth-keys/live-feed-admin-public.pem
LaravelAuth__CookieName=auction_operations_auth
LaravelAuth__CookieLifetimeSeconds=900
LaravelAuth__LaravelBaseUrl=http://localhost:8000
LaravelAuth__LaravelAdminUrl=http://localhost:8000/admin
LIVE_FEED_IDEMPOTENCY_TTL_SECONDS=86400
LIVE_FEED_DATABASE_URL=postgresql://auction_app:change_me_in_local_env@localhost:55432/auction_demo
LIVE_FEED_DB_POOL_MAX=5
LIVE_FEED_DB_IDLE_TIMEOUT_MS=10000
LIVE_FEED_DB_CONNECTION_TIMEOUT_MS=2000
CLIENT_ORIGIN=http://localhost:8000
VITE_BIDDING_API_URL=http://localhost:5000
VITE_LIVE_FEED_URL=http://localhost:3001
Scheduler__PollIntervalSeconds=1
Scheduler__BatchSize=20
